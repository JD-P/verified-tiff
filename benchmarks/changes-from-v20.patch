+//! Native segment orchestration and libtiff RGBA presentation (unverified ABI).
+//! Generic compression and sample transforms call verified native primitives.
+//! Older specialized codecs use a bounded, one-segment TIFF view and the
+//! original verified inspectors/decoders; never an external codec library.
+use super::*;
+use verified_tiff::{native,native_samples as ns};
+
+impl Handle{
+    pub fn native_ok(&self)->R<()>{
+        let m=&self.meta;
+        if m.photo==6 && !self.jpeg_rgb{return Err((NOTIMPL,"native subsampled YCbCr not implemented; request JPEGCOLORMODE_RGB"));}
+        if m.photo==32845 && !self.logluv16{return Err((NOTIMPL,"LogLuv conversion not implemented; request SGILOGDATAFMT_16BIT"));}
+        Ok(())
+    }
+    fn segment(&mut self,k:usize,budget:&mut Budget)->R<()>{
+        if self.cache.as_ref().is_some_and(|(i,_)|*i==k){return Ok(());}
+        self.cache=None;
+        let m=&self.meta;let rows=m.segment_rows(k)?;let row=m.row_bytes(m.bw)?;
+        let needed=product(row,rows)?;
+        if needed>self.limits.max_output{return Err((LIMIT,"native segment output limit"));}
+        let n=usize::try_from(m.counts[k]).map_err(|_|(LIMIT,"encoded segment size overflow"))?;
+        let mut encoded=self.source.read(m.offsets[k],n)?;
+        let mem=&self.source.mem;
+        let output=if matches!(m.compression,1|32773|5|8|32946){
+            if !matches!(m.bits,1|2|4|8|16|32|64) || !matches!(m.format,1|2|3|4) || (m.format==3 && !matches!(m.bits,32|64)){
+                return Err((NOTIMPL,"native sample width/format not implemented"));
+            }
+            if m.predictor!=1 && m.predictor!=2{return Err((NOTIMPL,"sample predictor not implemented"));}
+            if m.predictor==2 && (m.bits<8 || !matches!(m.compression,5|8|32946)){return Err((NOTIMPL,"horizontal prediction requires byte samples and LZW/Deflate"));}
+            if m.fill==2{ns::reverse_bits(&mut encoded);}
+            let cap=if matches!(m.compression,8|32946) && !m.tiled{product(row,m.bh)?}else{needed};
+            if cap>self.limits.max_output{return Err((LIMIT,"decoded padding limit"));}
+            let mut raw=Buf::zeros(needed,self.limits.max_output,mem)?;
+            native::decode(&encoded,m.compression,row,needed,cap,&mut raw,budget).map_err(err)?;
+            if m.bits<8 || (m.predictor==1 && (m.bits==8 || m.le==cfg!(target_endian="little"))){raw}else{
+                let mut out=Buf::zeros(needed,self.limits.max_output,mem)?;
+                ns::convert(&raw,row,if m.planar==2{1}else{m.ch},m.bits/8,m.le,m.predictor==2,cfg!(target_endian="little"),&mut out).map_err(err)?;
+                out
+            }
+        }else{self.special(k,&encoded,budget)?};
+        if output.len()!=needed{return Err((NOTIMPL,"special codec native layout mismatch"));}
+        self.cache=Some((k,output));Ok(())
+    }
+    pub fn read(&mut self,kind:u32,a:usize,b:usize,c:usize,_d:usize)->R<()>{
+        self.rendered=None;
+        let mut budget=Budget{remaining:self.work};
+        match kind{
+            0=>{
+                self.native_ok()?;
+                let m=&self.meta;if m.tiled{return Err((NOTIMPL,"scanline reads on tiled images not implemented"));}
+                if a>=m.height || (m.planar==2 && b>=m.ch) || (m.planar==1 && b!=0){return Err((INVALID,"scanline row/sample out of range"));}
+                let row=m.row_bytes(m.width)?;let idx=a/m.bh+if m.planar==2{b*m.per_plane()?}else{0};let within=(a%m.bh)*row;
+                self.segment(idx,&mut budget)?;let mut out=Buf::zeros(row,self.limits.max_output,&self.source.mem)?;
+                out.copy_from_slice(&self.cache.as_ref().unwrap().1[within..within+row]);self.rendered=Some(out);
+            }
+            1|2=>{
+                self.native_ok()?;if (kind==2)!=self.meta.tiled{return Err((INVALID,"strip/tile API does not match layout"));}
+                self.segment(a,&mut budget)?;let data=&self.cache.as_ref().unwrap().1;
+                let mut out=Buf::zeros(data.len(),self.limits.max_output,&self.source.mem)?;out.copy_from_slice(data);self.rendered=Some(out);
+            }
+            3=>{
+                let m=&self.meta;if a>=m.offsets.len(){return Err((INVALID,"segment index out of range"));}
+                let n=usize::try_from(m.counts[a]).map_err(|_|(LIMIT,"raw segment size overflow"))?;
+                self.rendered=Some(self.source.read(m.offsets[a],n)?);
+            }
+            4=>{
+                if a!=self.meta.width || b!=self.meta.height{return Err((NOTIMPL,"RGBA whole-image dimensions must match image"));}
+                self.rgba(0,0,a,b,c)?;
+            }
+            5=>{
+                let m=&self.meta;if m.tiled || a>=m.height || a%m.bh!=0{return Err((INVALID,"invalid RGBA strip row"));}
+                self.rgba(0,a,m.width,m.bh.min(m.height-a),4)?;
+            }
