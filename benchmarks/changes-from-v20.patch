+  {TIFFTAG_GROUP4OPTIONS,TIFF_LONG,1,1,0,4,0,0,"Group4Options"},
+  {TIFFTAG_PREDICTOR,TIFF_SHORT,1,1,0,2,0,0,"Predictor"},
+  {TIFFTAG_JPEGTABLES,TIFF_UNDEFINED,-3,-3,1,1,4,0,"JPEGTables"}
+};
+static const TIFFField *field(uint32_t tag) {
+  for (size_t i=0;i<sizeof(fields)/sizeof(fields[0]);i++)
+    if (fields[i].tag==tag) return &fields[i];
+  return NULL;
+}
+const TIFFField *TIFFFindField(TIFF *t,uint32_t tag,TIFFDataType type) {
+  if (!valid(t,__func__)) return NULL;
+  const TIFFField *f=field(tag);
+  return f && (type==TIFF_ANY || type==f->type) ? f : NULL;
+}
+const TIFFField *TIFFFieldWithTag(TIFF *t,uint32_t tag) {
+  const TIFFField *f=TIFFFindField(t,tag,TIFF_ANY);
+  if (!f) vt_not_implemented_for(t,__func__);
+  return f;
+}
+const TIFFField *TIFFFieldWithName(TIFF *t,const char *name) {
+  if (!valid(t,__func__) || !name) return NULL;
+  for (size_t i=0;i<sizeof(fields)/sizeof(fields[0]);i++)
+    if (!strcmp(fields[i].name,name)) return &fields[i];
+  vt_not_implemented_for(t,__func__); return NULL;
+}
+uint32_t TIFFFieldTag(const TIFFField *f) {return f?f->tag:0;}
+const char *TIFFFieldName(const TIFFField *f) {return f?f->name:NULL;}
+TIFFDataType TIFFFieldDataType(const TIFFField *f) {return f?f->type:TIFF_NOTYPE;}
+int TIFFFieldPassCount(const TIFFField *f) {return f?f->pass_count:0;}
+int TIFFFieldReadCount(const TIFFField *f) {return f?f->read_count:0;}
+int TIFFFieldWriteCount(const TIFFField *f) {return f?f->write_count:0;}
+int TIFFFieldSetGetSize(const TIFFField *f) {return f?f->size:0;}
+int TIFFFieldSetGetCountSize(const TIFFField *f) {return f?f->count_size:0;}
+int TIFFFieldIsAnonymous(const TIFFField *f) {(void)f;return 0;}
+/* As upstream, the tag list contains custom fields, not baseline image tags.
+ * This adapter exposes the supported custom descriptors above. */
+int TIFFGetTagListCount(TIFF *t) {
+  if (!valid(t,__func__)) return 0;
+  int count=0; size_t n=(size_t)info(t,15);
+  for (size_t i=0;i<n;i++){const TIFFField *f=field(vt_tag(t->state,i));if(f && f->custom)count++;}
+  return count;
+}
+uint32_t TIFFGetTagListEntry(TIFF *t,int index) {
+  if (!valid(t,__func__) || index<0) return (uint32_t)-1;
+  size_t n=(size_t)info(t,15);
+  for (size_t i=0;i<n;i++){uint32_t tag=vt_tag(t->state,i);const TIFFField *f=field(tag);if(f && f->custom && index--==0)return tag;}
+  return (uint32_t)-1;
+}
+static void unknown_warnings(TIFF *t) {
+  if (!t || !t->options.warn_unknown) return;
+  size_t n=(size_t)info(t,15);
+  for (size_t i=0;i<n;i++) {
+    uint32_t tag=vt_tag(t->state,i);
+    if (!field(tag) && !(tag>=512 && tag<=521) && tag!=529 && tag!=532)
+      TIFFWarningExtR(t,"TIFFReadDirectory","Unknown field with tag %u",tag);
+  }
+}
