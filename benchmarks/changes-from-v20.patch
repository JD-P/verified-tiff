+  {TIFFTAG_FILLORDER,TIFF_SHORT,1,1,0,2,0,0,"FillOrder"},
+  {TIFFTAG_DOCUMENTNAME,TIFF_ASCII,-1,-1,0,1,0,1,"DocumentName"},
+  {TIFFTAG_IMAGEDESCRIPTION,TIFF_ASCII,-1,-1,0,1,0,1,"ImageDescription"},
