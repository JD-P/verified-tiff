+/* Supported field descriptors follow libtiff 4.7.1 tif_dirinfo.c;
+ * upstream license is included in this directory. Unsupported registration
+ * and anonymous custom-field descriptors remain explicit ENOSYS operations. */
+struct _TIFFField {
+  uint32_t tag;
+  TIFFDataType type;
+  int read_count,write_count,pass_count,size,count_size,custom;
+  const char *name;
+};
+static const TIFFField fields[] = {
+  {TIFFTAG_SUBFILETYPE,TIFF_LONG,1,1,0,4,0,0,"SubfileType"},
+  {TIFFTAG_IMAGEWIDTH,TIFF_LONG,1,1,0,4,0,0,"ImageWidth"},
