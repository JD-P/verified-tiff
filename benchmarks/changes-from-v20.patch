+  {TIFFTAG_STRIPOFFSETS,TIFF_LONG8,-1,-1,0,0,0,0,"StripOffsets"},
+  {TIFFTAG_ORIENTATION,TIFF_SHORT,1,1,0,2,0,0,"Orientation"},
+  {TIFFTAG_SAMPLESPERPIXEL,TIFF_SHORT,1,1,0,2,0,0,"SamplesPerPixel"},
+  {TIFFTAG_ROWSPERSTRIP,TIFF_LONG,1,1,0,4,0,0,"RowsPerStrip"},
+  {TIFFTAG_STRIPBYTECOUNTS,TIFF_LONG8,-1,-1,0,0,0,0,"StripByteCounts"},
+  {TIFFTAG_MINSAMPLEVALUE,TIFF_SHORT,-2,-1,0,2,0,0,"MinSampleValue"},
+  {TIFFTAG_MAXSAMPLEVALUE,TIFF_SHORT,-2,-1,0,2,0,0,"MaxSampleValue"},
+  {TIFFTAG_XRESOLUTION,TIFF_RATIONAL,1,1,0,4,0,0,"XResolution"},
+  {TIFFTAG_YRESOLUTION,TIFF_RATIONAL,1,1,0,4,0,0,"YResolution"},
+  {TIFFTAG_PLANARCONFIG,TIFF_SHORT,1,1,0,2,0,0,"PlanarConfiguration"},
+  {TIFFTAG_PAGENAME,TIFF_ASCII,-1,-1,0,1,0,1,"PageName"},
+  {TIFFTAG_XPOSITION,TIFF_RATIONAL,1,1,0,4,0,0,"XPosition"},
+  {TIFFTAG_YPOSITION,TIFF_RATIONAL,1,1,0,4,0,0,"YPosition"},
+  {TIFFTAG_RESOLUTIONUNIT,TIFF_SHORT,1,1,0,2,0,0,"ResolutionUnit"},
+  {TIFFTAG_PAGENUMBER,TIFF_SHORT,2,2,0,2,0,0,"PageNumber"},
